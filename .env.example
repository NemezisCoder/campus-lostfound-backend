# === Server ===
APP_ENV=production
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
SITE_BASE_URL=http://localhost
CORS_ORIGINS=["http://localhost"]
DB_INIT_ON_STARTUP=false

# === Security (template only; keep real values in .env, not here) ===
SECRET_KEY=CHANGE_ME_SUPER_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REVOKE_OLD_SESSIONS_ON_LOGIN=true

# === PostgreSQL ===
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://campus:change-me@db:5432/campus

# === Optional local media fallback ===
MEDIA_DIR=./uploads

# === Weather ===
# Keep the real key in .env or another ignored env file.
OPENWEATHER_API_KEY=CHANGE_ME_OPENWEATHER_API_KEY
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
CAMPUS_LAT=55.6700
CAMPUS_LON=37.6500
WEATHER_CACHE_SECONDS=300

# === S3 / MinIO ===
S3_ENABLED=true
S3_BUCKET=campus-lostfound
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-password
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9010

# === Uploads ===
PRESIGN_EXPIRES_SECONDS=600
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp

# === Image tags used by docker-compose.yml ===
BACKEND_IMAGE=campus-lostfound-backend:local
FRONTEND_IMAGE=campus-lostfound-frontend:local
